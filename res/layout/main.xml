<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Banner Ad (Banner 1) -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/bannerTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-9901882669030871/9943965825" />

    <!-- Website Screen -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Middle Banner Ad (Banner 2) -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/bannerMiddle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-9901882669030871/7619028697" />

    <!-- Bottom Banner Ad (Banner 3) -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/bannerBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-9901882669030871/5711050659" />

</LinearLayout>
